GEMINI_API_KEY = "your-gemini-api-key-here"

# Gmail account that sends the summary email
GMAIL_ADDRESS = "your-email@gmail.com"

# 16-letter App Password from myaccount.google.com/apppasswords
# (needs 2-Step Verification; never use your real Gmail password)
GMAIL_APP_PASSWORD = "your-16-letter-app-password-here"